{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BLCVoice",
  "version": "0.1.0",
  "identifier": "com.blccorestudio.blcvoice",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BLCVoice",
        "width": 720,
        "height": 480,
        "minWidth": 560,
        "minHeight": 400,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
