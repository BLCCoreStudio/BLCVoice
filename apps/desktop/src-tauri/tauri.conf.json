{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BLCVoice",
  "version": "0.1.0",
  "identifier": "com.blccorestudio.blcvoice",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BLCVoice",
        "width": 760,
        "height": 680,
        "minWidth": 560,
        "minHeight": 520,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "BLCVoice Dictation",
        "url": "overlay.html",
        "width": 340,
        "height": 82,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
